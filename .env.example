# Copy to .env.local (ignored). Never put service-role or rate-limit secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# A random secret with at least 32 bytes, used for HMAC request identifiers.
RATE_LIMIT_SECRET=
# Exact browser origin; change to the HTTPS production origin when deploying.
APP_ORIGIN=http://localhost:3000
